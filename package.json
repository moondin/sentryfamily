    "compression": "^1.8.0",
    "express": "^5.0.1",
    "recharts": "^2.15.1",
    "sirv": "^3.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.1"
  }
